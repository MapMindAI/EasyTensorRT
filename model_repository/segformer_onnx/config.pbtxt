platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 3, 512, 512 ]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ 1, 150, 512, 512 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

default_model_filename: "segformer_b0_ade20k_512x512.onnx"
